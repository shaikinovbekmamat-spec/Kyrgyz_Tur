POSTGRES_DB=kyrgyz_tur
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Local development defaults. Set a random secret in the Vercel dashboard.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=
# Cloud PostgreSQL URL from Neon (takes precedence over POSTGRES_*).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Custom domains, if used, must also be included in DJANGO_ALLOWED_HOSTS.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Console for local development; use django.core.mail.backends.smtp.EmailBackend for SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
COMMENT_NOTIFICATION_EMAIL=admin@localhost

